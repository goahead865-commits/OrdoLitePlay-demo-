# Copy this file to .streamlit/secrets.toml for local testing.
# In Streamlit Community Cloud, paste the same values into Settings > Secrets.
# Never commit the real secrets.toml file.
[mysql]
host = "your-aiven-hostname.aivencloud.com"
port = 23724
user = "avnadmin"
password = "replace-with-your-aiven-password"
database = "ordoliteplay_demo"
