# Credentials and local configuration
.env
.streamlit/secrets.toml

# Python and Streamlit runtime files
__pycache__/
*.py[cod]
.venv/
_streamlit_*.log

# Local databases, backups, and generated artifacts
*.sql
*.sql.gz
*.bak
data/
# The UI translation dictionary is required at runtime and contains no business data.
!data/
!data/term_dictionary.xlsx
output/
outputs/
assets/uploads/

# Local tools and IDE state
node_modules/
.idea/
.agents/

# Keep the share-safe app configuration and a non-secret Secrets template
!.streamlit/config.toml
!.streamlit/secrets.toml.example
